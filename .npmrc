# dsh-client-runtime (0.1.x line) + 0.1.5-line packages coexist: pnpm drops the
# prerelease tag when intersecting their auto-installed peer ranges (^0.1.5-rc.2
# -> ^0.1.5, unpublished) and fails resolution. Missing peers are declared
# explicitly in devDependencies instead. Retry without this once DSH 0.1.5 final
# ships.
auto-install-peers=false
