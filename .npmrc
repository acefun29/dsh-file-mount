# Historical note: this used to be `auto-install-peers=false` — a 0.1.5-era
# workaround (pnpm dropped the prerelease tag when intersecting auto-installed
# peer ranges of the coexisting 0.1.x packages). The 0.2.0 line declares every
# peer explicitly (all optional, all present in devDependencies), so the
# workaround is retired and the setting is now pinned to pnpm's default to keep
# the lockfile's `settings:` block and every environment resolving identically.
# Do not flip this without regenerating pnpm-lock.yaml (the peer-suffix shape of
# every @deepseek-ai package changes with it).
auto-install-peers=true
